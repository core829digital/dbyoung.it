# --- App ---
NEXT_PUBLIC_SITE_URL=https://www.dbyoung.it
ADMIN_EMAIL=contact.core829@gmail.com

# --- Convex (progetto attivo: festive-ptarmigan-321) ---
NEXT_PUBLIC_CONVEX_URL=https://festive-ptarmigan-321.convex.cloud
CONVEX_HTTP_URL=https://festive-ptarmigan-321.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=https://festive-ptarmigan-321.convex.site
CONVEX_DEPLOYMENT=
# CONVEX_DEPLOYMENT=... (dopo `npx convex dev`)

# --- Resend (email transazionali + newsletter) ---
# RESEND_API_KEY=re_xxx
# RESEND_FROM=DBYoung <noreply@dbyoung.it>

# --- Stripe (checkout + webhook) ---
# Chiavi dalla dashboard Stripe (test: sk_test_... / live: sk_live_... o rk_live_...)
# STRIPE_SECRET_KEY=sk_test_xxx
# Webhook dedicato: https://www.dbyoung.it/api/stripe/webhook
# Eventi: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.expired, payment_intent.succeeded, charge.refunded
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID creati con scripts/stripe-setup.mjs (metadata project=dbyoung.it):
# STRIPE_PRICE_GIVE_A_START=price_xxx
# STRIPE_PRICE_SACRED_VOICES=price_xxx
# STRIPE_PRICE_VELVET_TAPE_NEO_SOUL_CHILLHOP=price_xxx
# STRIPE_PRICE_MELANCHOLIC_NEO_SOUL_PIANO=price_xxx
# STRIPE_PRICE_OPERA_CINEMATIC_ORCHESTRAL_TRAP=price_xxx
# STRIPE_PRICE_VELVET_NOSTALGIA_CINEMATIC=price_xxx
# STRIPE_PRICE_BUNDLE_COMPLETO=price_xxx
# STRIPE_PRICE_PRODUZIONE_PERSONALIZZATA_ACCONTO=price_xxx

# --- Download storage (Vercel Blob) ---
# Creare Blob store in Vercel → Storage → Blob; copiare il token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# URL generati da `npx --yes tsx scripts/upload-blob.ts` (solo prodotti vendibili):
# BLOB_URL_GIVE_A_START=https://xxx.public.blob.vercel-storage.com/products/give-a-start.wav
# BLOB_URL_SACRED_VOICES=https://xxx.public.blob.vercel-storage.com/products/sacred-voices.wav
# BLOB_URL_VELVET_TAPE_NEO_SOUL_CHILLHOP=https://xxx.public.blob.vercel-storage.com/products/velvet-tape-neo-soul-chillhop.zip
# BLOB_URL_MELANCHOLIC_NEO_SOUL_PIANO=https://xxx.public.blob.vercel-storage.com/products/melancholic-neo-soul-piano.zip
# BLOB_URL_OPERA_CINEMATIC_ORCHESTRAL_TRAP=https://xxx.public.blob.vercel-storage.com/products/opera-cinematic-orchestral-trap.zip
# BLOB_URL_VELVET_NOSTALGIA_CINEMATIC=https://xxx.public.blob.vercel-storage.com/products/velvet-nostalgia-cinematic.zip

# --- Cloudflare Turnstile (anti-bot su form pubblici + auth + checkout) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# Senza TURNSTILE_SECRET_KEY la verifica è accettata solo in sviluppo (mai in produzione).

# --- Auth server-side (firme HMAC azioni Convex + sessioni) ---
# Segreto condiviso Next ↔ Convex per firmare le chiamate privilegiate (32+ byte casuali).
# ADMIN_ACTION_SECRET=[GENERARE CON: openssl rand -hex 32]
# Stesso valore anche nelle env di Convex (dashboard Convex → Settings → Environment Variables).
# Cifratura segreti TOTP (base64 di 32 byte casuali), solo env Convex + server Next (mai client).
# TOTP_ENCRYPTION_KEY=[base64 di 32 byte casuali]
# IP consentiti per /admin e /api/admin/* (vuoto = nessun filtro). Es: ADMIN_IP_ALLOWLIST=93.184.216.0/24,203.0.113.8
# ADMIN_IP_ALLOWLIST=
# Email admin (può essere lista separata da virgole):
# ADMIN_EMAILS=contact.core829@gmail.com

# --- Booking ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/dbyoung/eventi
